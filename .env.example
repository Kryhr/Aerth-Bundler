# ────────────────────────────────────────────────────────────────
# AERTH BUNDLER - Environment Configuration
# Copy this to .env and fill in your values
# ────────────────────────────────────────────────────────────────

# ─── Network ────────────────────────────────────────────────────
# Use devnet for testing, mainnet for real funds
NETWORK=devnet
RPC_ENDPOINT=https://api.devnet.solana.com
WS_ENDPOINT=wss://api.devnet.solana.com

# ─── Wallet ─────────────────────────────────────────────────────
# Your main wallet private key (base58 encoded)
# WARNING: Never commit this to git!
MAIN_WALLET_PRIVATE_KEY=your_private_key_here

# Encryption password for wallet files
WALLET_ENCRYPTION_PASSWORD=your_strong_password_change_me

# Wallet folder
WALLET_FOLDER=./wallets

# ─── Token ──────────────────────────────────────────────────────
# Token name and symbol
TOKEN_NAME=LARPAI
TOKEN_SYMBOL=LARP
TOKEN_SUPPLY=1000000000
INITIAL_LIQUIDITY=1.0

# ─── Bundler ────────────────────────────────────────────────────
# Number of bundled wallets
NUMBER_OF_WALLETS=10

# Buy amounts (SOL)
MIN_BUY_AMOUNT=0.05
MAX_BUY_AMOUNT=0.5

# Target multiplier (2x - 5x)
TARGET_MULTIPLIER=5.0

# Max duration before auto-exit (hours)
EXIT_TIMER_HOURS=5

# Slippage tolerance (percent)
MAX_SLIPPAGE=50

# Daily volume target (SOL)
TARGET_DAILY_VOLUME=50

# Volume pattern: Organic Growth | Pump & Consolidate | Whale Accumulation | Volume Spikes | Market Making
VOLUME_PATTERN=Organic Growth

# ─── Dashboard ──────────────────────────────────────────────────
# Enable/disable dashboard
DASHBOARD_ENABLED=true

# Dashboard type: full | simple
DASHBOARD_TYPE=full

# Refresh interval (ms)
REFRESH_INTERVAL=1000

# ─── Logging ────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info