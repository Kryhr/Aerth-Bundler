{
  "name": "aerth-bundler",
  "version": "1.0.0",
  "description": "AERTH BUNDLER - Automated token launch, volume simulation, and coordinated exit on Solana",
  "main": "dist/app.js",
  "scripts": {
    "start:devnet": "npx tsx src/app.ts --devnet",
    "start:mainnet": "npx tsx src/app.ts --mainnet",
    "dev": "npx nodemon --exec npx tsx src/app.ts --devnet",
    "generate-wallets": "npx tsx src/scripts/generateWallets.ts --devnet",
    "generate-wallets:mainnet": "npx tsx src/scripts/generateWallets.ts --mainnet",
    "fund": "npx tsx src/scripts/fundWallets.ts",
    "reclaim": "npx tsx src/scripts/reclaimSol.ts",
    "redistribute": "npx tsx src/scripts/redistributeSol.ts",
    "balances": "npx tsx src/scripts/showBalances.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^1.36.0",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.95.0",
    "bip39": "^3.1.0",
    "bs58": "^5.0.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "tsx": "^4.7.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
